# Copy to .env and fill in. Everything is optional except KG_ADO_* when ingesting from Azure DevOps.
KG_ADO_URL=https://tfs.example.local/tfs/DefaultCollection
KG_ADO_PROJECT=YourProject
KG_ADO_PAT=
# KG_REPO_INCLUDE=^(order|billing)-
# KG_REPO_EXCLUDE=-archive$

# History (kg history): first-run window and work item types to load
# KG_HISTORY_MONTHS=24
# KG_WORK_ITEM_TYPES=Product Backlog Item,Bug,Feature,Epic,Task,User Story

# Corporate CA: put ca.crt in ./certs and uncomment
# KG_CA_BUNDLE=/certs/ca.crt

# Corporate proxy, if the browser needs one to reach TFS
# HTTPS_PROXY=http://proxy.example.local:8080
# HTTP_PROXY=http://proxy.example.local:8080
# NO_PROXY=neo4j,localhost,127.0.0.1

# KG_NEO4J_PASSWORD=devpassword
# KG_MCP_PORT=8000
# NEO4J_HEAP=2G
# NEO4J_PAGECACHE=1G
# Pin a version instead of latest, or point at a Nexus proxy of GHCR:
# KG_IMAGE=ghcr.io/hayridurmaz/tfs-knowledge-extractor:0.1.0
